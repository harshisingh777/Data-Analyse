{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 2048,
      "excludeFiles": "{tests/**,docs/**,scripts/**,.github/**,**/__pycache__/**,**/*.md}"
    }
  }
}
